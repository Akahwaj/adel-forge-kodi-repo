<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.program.adelforgewizard" name="Adel Forge Wizard" version="1.0.2" provider-name="Adel">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Adel Forge TV Build Wizard</summary>
    <description lang="en_GB">Xenon-style custom build wizard with Fire TV optimization profiles, buffer/cache tuning, maintenance tools, and backup/restore for Sentinel Build 2026.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/Akahwaj/adel-forge-kodi-repo</source>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.png</fanart>
    </assets>
  </extension>
</addon>
<addon id="repo.adelforgewizard" name="Adel Forge Repository" version="1.0.1" provider-name="Adel">
  <extension point="xbmc.addon.repository" name="Adel Forge Repository">
    <dir>
      <info compressed="false">https://akahwaj.github.io/adel-forge-kodi-repo/addons.xml</info>
      <checksum>https://akahwaj.github.io/adel-forge-kodi-repo/addons.xml.md5</checksum>
      <datadir zip="true">https://akahwaj.github.io/adel-forge-kodi-repo/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Adel Forge / Sentinel Build Repository</summary>
    <description lang="en_GB">Official repository for the Adel Forge Wizard and Sentinel Build 2026 add-ons. Provides updates for the Adel Forge Wizard directly within Kodi.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/Akahwaj/adel-forge-kodi-repo</source>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.png</fanart>
    </assets>
  </extension>
</addon>
</addons>
